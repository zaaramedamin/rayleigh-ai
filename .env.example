# Copy to .env and adjust. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Local storage (gitignored)
DATA_DIR=./data
MODELS_DIR=./models

# Folders Reyleight is allowed to index (comma-separated allow-list).
# Nothing outside these folders is ever read.
ALLOWED_FOLDERS=

# Maximum size (in MB) of a single file to ingest. Larger files are skipped.
MAX_FILE_SIZE_MB=5

# Local services (added in later steps)
# QDRANT_URL=http://localhost:6333
# OLLAMA_URL=http://localhost:11434
