# Copy to .env and adjust. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Local storage (gitignored)
DATA_DIR=./data
MODELS_DIR=./models

# Folders Reyleight is allowed to index (comma-separated allow-list).
# Nothing outside these folders is ever read.
ALLOWED_FOLDERS=

# Maximum size (in MB) of a single file to ingest. Larger files are skipped.
MAX_FILE_SIZE_MB=5

# Chunking (characters). Overlap must be smaller than size.
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# Local embedding model (sentence-transformers). Download once with `python -m app download-model`.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of chunks a search returns by default (1-50).
RETRIEVAL_TOP_K=5

# How notes are found: vector (by meaning), keyword (by the words in the question) or hybrid
# (both, merged). Hybrid finds exact codes and names that meaning search misses.
SEARCH_MODE=hybrid

# A note must score at least this (0-1) to be used for an answer. If none does, the assistant
# says it does not have enough information. Tuned with the evaluation set.
ANSWER_MIN_SCORE=0.30

# Local LLM, served by Ollama on this machine (remote addresses are rejected).
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=120
# true lets the model reason before answering: much slower, sometimes better.
LLM_THINK=false

# PDF and Office files are read by a separate process with a time limit.
PARSER_TIMEOUT_SECONDS=120
# PDFs with more pages than this are skipped.
PDF_MAX_PAGES=2000
# true keeps running headers and page numbers in PDF text (they are dropped by default, because
# they would match nearly every question).
PDF_KEEP_HEADERS_FOOTERS=false

# Voice orders: local speech recognition (Whisper). Download once with
# `python -m app download-voice-model`. SPEECH_LANGUAGE is a code such as en or fr; empty detects it.
SPEECH_MODEL=openai/whisper-base
SPEECH_LANGUAGE=

# The API answers only to this computer. Names besides 127.0.0.1, localhost and ::1 that it
# may be reached by (comma separated), and other web pages allowed to read its answers (for
# example the development server, http://127.0.0.1:5173). Leave both empty normally.
ALLOWED_HOSTS=
CORS_ORIGINS=
# The largest request the API reads (MB), and how many it accepts per minute.
MAX_REQUEST_MB=8
RATE_LIMIT_PER_MINUTE=1200

# Stored conversations that were not touched for this many days are deleted. 0 (the
# default) keeps them until you delete them in the interface.
CONVERSATION_RETENTION_DAYS=0

# Vector store: embedded Qdrant under DATA_DIR/qdrant (no server needed).
